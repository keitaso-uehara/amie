# amie バックエンド環境変数（.env にコピーして値を設定）
# ※ 本ファイルはサンプル。実際のキーはコミットしないこと。

# --- Supabase（プロジェクト作成後に取得）---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...           # フロントに渡す公開キー
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # Edge Function 専用・絶対に公開しない

# --- Stripe（決済・Connectでエスクロー的運用）---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Daily.co（ビデオ通話）---
DAILY_API_KEY=...

# --- eKYC（本人確認・出金/上限解除）---
STRIPE_IDENTITY_ENABLED=true

# --- メール通知（Resend 等）---
RESEND_API_KEY=re_...
